{
  "name": "react-boleto",
  "version": "1.0.0",
  "dependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@storybook/addon-essentials": "9.0.0-alpha.12",
    "@storybook/addon-interactions": "9.0.0-alpha.10",
    "@storybook/addon-links": "^9.1.5",
    "@storybook/addon-onboarding": "^9.1.5",
    "@storybook/blocks": "9.0.0-alpha.17",
    "@storybook/react": "9.1.5",
    "@storybook/react-vite": "^9.1.5",
    "@storybook/test": "9.0.0-alpha.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/yargs": "^17.0.32",
    "glob": "^11.0.3",
    "pdf-visual-diff": "^0.14.0",
    "storybook": "^9.1.5",
    "tsup": "^8.0.2",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4",
    "yargs": "^18.0.0"
  },
  "keywords": [
    "boleto",
    "pdf",
    "react"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --minify --dts --out-dir dist",
    "build-storybook": "storybook build",
    "generate:pdfs": "tsx ./src/bin/generate-pdfs.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "test:pdf-approve": "pdf-visual-diff approve",
    "test:pdf-reject": "pdf-visual-diff reject",
    "test:vitest": "vitest --passWithNoTests --reporter verbose",
    "type-check": "tsc --noEmit"
  },
  "type": "module"
}
